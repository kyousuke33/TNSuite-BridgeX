<?xml version="1.0" encoding="utf-8"?>
<!-- Hotfix25: dark BridgeX installer theme with full-height sidebar; maintenance behavior remains WixStdBA. -->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
  <!-- Colors are BGR hex per ThmUtil. Keep native buttons/edit boxes readable while the content surface is dark. -->
  <Font Id="0" Height="-12" Weight="500" Foreground="btntext" Background="btnface">Segoe UI</Font>
  <Font Id="1" Height="-22" Weight="600" Foreground="ffffff" Background="271810">Segoe UI</Font>
  <Font Id="2" Height="-16" Weight="500" Foreground="c7b8a7" Background="271810">Segoe UI</Font>
  <Font Id="3" Height="-12" Weight="500" Foreground="eeeae6" Background="271810">Segoe UI</Font>
  <Font Id="5" Height="-12" Weight="400" Foreground="eeeae6" Background="271810">Segoe UI</Font>
  <Font Id="6" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>

  <Window Width="620" Height="390" HexStyle="100a0000" FontId="5" Caption="#(loc.Caption)">
    <!-- The window itself paints the dark client surface. No full-window label overlays are used,
         because they can obscure page controls in WixStdBA. The Hotfix25 sidebar asset is
         authored at 164x390, has no cyan edge stripe, and therefore fills the full client height
         without stretching or covering the button row. -->
    <ImageControl X="0" Y="0" Width="164" Height="390" ImageFile="logo.png" Visible="yes" />
    <Label X="184" Y="18" Width="-18" Height="34" FontId="1" Visible="yes" DisablePrefix="yes">#(loc.Title)</Label>
    <Label X="184" Y="48" Width="-18" Height="24" FontId="2" Visible="yes" DisablePrefix="yes">Secure Transfer &amp; Automation</Label>

    <Page Name="Loading">
      <Label X="184" Y="90" Width="-18" Height="30" FontId="2" DisablePrefix="yes" Visible="no" Name="CheckingForUpdatesLabel" />
    </Page>

    <Page Name="Help">
      <Label X="184" Y="90" Width="-18" Height="30" FontId="2" DisablePrefix="yes">#(loc.HelpHeader)</Label>
      <Label X="184" Y="122" Width="-18" Height="-42" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
      <Button Name="HelpCloseButton" X="-18" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0"><Text>#(loc.HelpCloseButton)</Text><CloseWindowAction /></Button>
    </Page>

    <Page Name="Install">
      <Label X="184" Y="88" Width="-18" Height="32" FontId="1" DisablePrefix="yes">
        <Text Condition="DetectedBridgeXMsiVersion &gt; v0.0.0.0 AND DetectedBridgeXMsiVersion &lt; TargetBridgeXMsiVersion">#(loc.UpdateHeader)</Text>
        <Text Condition="NOT (DetectedBridgeXMsiVersion &gt; v0.0.0.0 AND DetectedBridgeXMsiVersion &lt; TargetBridgeXMsiVersion)">#(loc.InstallHeader)</Text>
      </Label>
      <Label X="184" Y="128" Width="-18" Height="112" FontId="3" DisablePrefix="yes">
        <Text Condition="DetectedBridgeXMsiVersion &gt; v0.0.0.0 AND DetectedBridgeXMsiVersion &lt; TargetBridgeXMsiVersion">#(loc.UpdateMessage)</Text>
        <Text Condition="NOT (DetectedBridgeXMsiVersion &gt; v0.0.0.0 AND DetectedBridgeXMsiVersion &lt; TargetBridgeXMsiVersion) AND WixStdBASuppressOptionsUI">#(loc.InstallMessage)</Text>
        <Text Condition="NOT (DetectedBridgeXMsiVersion &gt; v0.0.0.0 AND DetectedBridgeXMsiVersion &lt; TargetBridgeXMsiVersion) AND NOT WixStdBASuppressOptionsUI">#(loc.InstallMessageOptions)</Text>
      </Label>
      <Hypertext Name="EulaHyperlink" X="184" Y="246" Width="-18" Height="17" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallLicenseLinkText)</Hypertext>
      <Label Name="InstallVersion" X="184" Y="270" Width="300" Height="17" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>
      <Checkbox Name="EulaAcceptCheckbox" X="184" Y="294" Width="300" Height="17" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
      <Button Name="OptionsButton" X="-188" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0" VisibleCondition="NOT WixStdBASuppressOptionsUI AND NOT (DetectedBridgeXMsiVersion &gt; v0.0.0.0 AND DetectedBridgeXMsiVersion &lt; TargetBridgeXMsiVersion)"><Text>#(loc.InstallOptionsButton)</Text><ChangePageAction Page="Options" /></Button>
      <Button Name="InstallButton" X="-102" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0" ElevationShieldCondition='(WixBundleAuthoredScope = 1 AND NOT WixBundleElevated) OR ((WixBundleAuthoredScope = 2 OR WixBundleAuthoredScope = 3) AND WixStdBAScope = "PerMachine")'>
        <Text Condition="DetectedBridgeXMsiVersion &gt; v0.0.0.0 AND DetectedBridgeXMsiVersion &lt; TargetBridgeXMsiVersion">#(loc.InstallUpdateButton)</Text>
        <Text Condition="NOT (DetectedBridgeXMsiVersion &gt; v0.0.0.0 AND DetectedBridgeXMsiVersion &lt; TargetBridgeXMsiVersion)">#(loc.InstallInstallButton)</Text>
      </Button>
      <Button Name="InstallCancelButton" X="-18" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0"><Text>#(loc.InstallCancelButton)</Text><CloseWindowAction /></Button>
    </Page>

    <Page Name="Options">
      <Label X="184" Y="88" Width="-18" Height="32" FontId="1" DisablePrefix="yes">#(loc.OptionsHeader)</Label>
      <Label X="184" Y="132" Width="-18" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsLocationLabel)</Label>
      <Editbox Name="InstallFolder" X="184" Y="154" Width="-104" Height="22" TabStop="yes" FontId="6" FileSystemAutoComplete="yes" />
      <Button Name="BrowseButton" X="-18" Y="153" Width="78" Height="24" TabStop="yes" FontId="0"><Text>#(loc.OptionsBrowseButton)</Text><BrowseDirectoryAction VariableName="InstallFolder" /></Button>
      <Label X="184" Y="184" Width="-18" Height="40" FontId="3" DisablePrefix="yes">#(loc.OptionsAutoSubfolderHint)</Label>
      <Checkbox Name="CreateDesktopShortcut" X="184" Y="236" Width="-18" Height="20" TabStop="yes" FontId="3">#(loc.OptionsDesktopShortcutCheckbox)</Checkbox>
      <Button Name="OptionsOkButton" X="-102" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0"><Text>#(loc.OptionsOkButton)</Text><ChangePageAction Page="Install" /></Button>
      <Button Name="OptionsCancelButton" X="-18" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0"><Text>#(loc.OptionsCancelButton)</Text><ChangePageAction Page="Install" Cancel="yes" /></Button>
    </Page>

    <Page Name="Progress">
      <Label X="184" Y="88" Width="-18" Height="32" FontId="1" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
      <Label X="184" Y="134" Width="70" Height="17" FontId="3" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
      <Label Name="OverallProgressPackageText" X="256" Y="134" Width="-18" Height="17" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
      <Progressbar Name="OverallCalculatedProgressbar" X="184" Y="161" Width="-18" Height="16" />
      <Button Name="ProgressCancelButton" X="-18" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
    </Page>

    <Page Name="Modify">
      <Label X="184" Y="88" Width="-18" Height="32" FontId="1" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
      <Label X="184" Y="132" Width="-18" Height="70" FontId="3" DisablePrefix="yes">#(loc.ModifyMessage)</Label>
      <Button Name="RepairButton" X="-188" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0" HideWhenDisabled="yes" ElevationShieldCondition='(WixBundleAuthoredScope = 1 AND NOT WixBundleElevated) OR ((WixBundleAuthoredScope = 2 OR WixBundleAuthoredScope = 3) AND WixStdBAScope = "PerMachine")'>#(loc.ModifyRepairButton)</Button>
      <Button Name="UninstallButton" X="-102" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0" ElevationShieldCondition='(WixBundleAuthoredScope = 1 AND NOT WixBundleElevated) OR ((WixBundleAuthoredScope = 2 OR WixBundleAuthoredScope = 3) AND WixStdBAScope = "PerMachine")'>#(loc.ModifyUninstallButton)</Button>
      <Button Name="ModifyCancelButton" X="-18" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0"><Text>#(loc.ModifyCancelButton)</Text><CloseWindowAction /></Button>
    </Page>

    <Page Name="Success">
      <Label X="184" Y="88" Width="-18" Height="32" FontId="1" DisablePrefix="yes">
        <Text>#(loc.SuccessHeader)</Text><Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text><Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallHeader)</Text><Text Condition="WixBundleAction = 5">#(loc.SuccessInstallHeader)</Text><Text Condition="WixBundleAction = 7">#(loc.SuccessRepairHeader)</Text>
      </Label>
      <Label X="184" Y="132" Width="-18" Height="42" FontId="3" DisablePrefix="yes">#(loc.SuccessMessage)</Label>
      <Checkbox Name="LaunchAfterInstall" X="184" Y="190" Width="-18" Height="20" TabStop="yes" FontId="3" VisibleCondition="WixBundleAction = 5 AND NOT WixStdBARestartRequired">#(loc.SuccessLaunchCheckbox)</Checkbox>
      <Label X="184" Y="238" Width="-18" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired"><Text>#(loc.SuccessRestartText)</Text><Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallRestartText)</Text></Label>
      <Button Name="SuccessRestartButton" X="-102" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
      <Button Name="LaunchButton" X="-18" Y="-14" Width="92" Height="24" TabStop="yes" FontId="0" VisibleCondition="WixBundleAction = 5 AND LaunchAfterInstall AND NOT WixStdBARestartRequired">#(loc.SuccessFinishLaunchButton)</Button>
      <Button Name="SuccessCloseButton" X="-18" Y="-14" Width="92" Height="24" TabStop="yes" FontId="0" VisibleCondition="NOT (WixBundleAction = 5 AND LaunchAfterInstall AND NOT WixStdBARestartRequired)"><Text>#(loc.SuccessFinishButton)</Text><CloseWindowAction /></Button>
    </Page>

    <Page Name="Failure">
      <Label X="184" Y="88" Width="-18" Height="32" FontId="1" DisablePrefix="yes"><Text>#(loc.FailureHeader)</Text><Text Condition="WixBundleAction = 2">#(loc.FailureLayoutHeader)</Text><Text Condition="WixBundleAction = 3">#(loc.FailureUninstallHeader)</Text><Text Condition="WixBundleAction = 5">#(loc.FailureInstallHeader)</Text><Text Condition="WixBundleAction = 7">#(loc.FailureRepairHeader)</Text></Label>
      <Hypertext Name="FailureLogFileLink" X="184" Y="132" Width="-18" Height="42" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
      <Hypertext Name="FailureMessageText" X="184" Y="180" Width="-18" Height="60" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
      <Label X="184" Y="248" Width="-18" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
      <Button Name="FailureRestartButton" X="-102" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
      <Button Name="FailureCloseButton" X="-18" Y="-14" Width="78" Height="24" TabStop="yes" FontId="0"><Text>#(loc.FailureCloseButton)</Text><CloseWindowAction /></Button>
    </Page>
  </Window>
</Theme>
