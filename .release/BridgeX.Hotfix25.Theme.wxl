  <String Id="HelpHeader" Value="Setup Help" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - installs, repairs, uninstalls or creates a local bundle copy.&#xA;&#xA;/passive | /quiet - minimal or no UI.&#xA;/norestart - suppress restart prompts.&#xA;/log log.txt - writes setup logs." />
