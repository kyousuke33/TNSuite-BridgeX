msgstr "&Báo lỗi..."

msgid "Welcome to TNSuite BridgeX"
msgstr "Chào mừng đến TNSuite BridgeX"

msgid "What's new in BridgeX"
msgstr "Điểm mới trong BridgeX"

msgid "BridgeX Build12 adds a redesigned connection header, Light/Dark themes, and English/Vietnamese UI."
msgstr "BridgeX Build12 bổ sung khu vực kết nối được thiết kế lại, chủ đề Sáng/Tối và giao diện Tiếng Anh/Tiếng Việt."

msgid "Getting help"
msgstr "Trợ giúp"

msgid "Open Help > Getting help for the local BridgeX guide."
msgstr "Mở Trợ giúp > Trợ giúp để xem hướng dẫn BridgeX cục bộ."

msgid "Use Help > Report a bug for the BridgeX diagnostic checklist."
msgstr "Dùng Trợ giúp > Báo lỗi để xem checklist chẩn đoán BridgeX."

msgid "Documentation"
msgstr "Tài liệu"

msgid "Sites stores reusable connections; Quick Connect is for one-off sessions."
msgstr "Sites lưu các kết nối dùng lại; Quick Connect dành cho phiên kết nối nhanh."

msgid "Automation opens the BridgeX CLI for scripted SFTP operations."
msgstr "Automation mở BridgeX CLI để chạy các thao tác SFTP bằng script."

msgid "Appearance and language are configured in Settings > Interface."
msgstr "Chủ đề và ngôn ngữ được cấu hình tại Settings > Interface."

msgid "About TNSuite BridgeX"
msgstr "Giới thiệu TNSuite BridgeX"

msgid "Homepage:"
msgstr "Trang chủ:"

