msgstr "Mở BridgeX &CLI"

msgid "Open the BridgeX automation CLI in PowerShell"
msgstr "Mở CLI tự động hóa BridgeX trong PowerShell"

msgid "Run CLI &Doctor"
msgstr "Chạy CLI &Doctor"

msgid "Validate Windows OpenSSH and BridgeX CLI runtime"
msgstr "Kiểm tra Windows OpenSSH và runtime BridgeX CLI"

